<Application x:Class="Synopio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Accent colors -->
        <Color x:Key="{x:Static SystemColors.AccentColorKey}">#2F6B4E</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#3F7F60</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#86BC9C</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#A8D1B8</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#2F6B4E</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#24543D</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#1B2B23</Color>
    </Application.Resources>
</Application>
